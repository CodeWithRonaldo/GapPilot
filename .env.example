# Copy this file to .env and fill in your keys. Never commit .env.

# LLM provider is chosen in agent/config.json ("provider": "groq" or "gemini").
# Groq (default), free key: https://console.groq.com/keys
GROQ_API_KEY=

# Gemini (optional), free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Dev.to: Settings > Extensions > DEV Community API Keys
DEVTO_API_KEY=

# Set to true to stop the agent before any action
KILL_SWITCH=false
