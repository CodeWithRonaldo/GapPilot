# Copy this file to .env and fill in your keys. Never commit .env.

# Terminal agent tries Claude, then Groq, then Gemini. Configure one or more keys.
# The legacy pipeline uses the same provider order from agent/config.json.
# Claude key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Groq key: https://console.groq.com/keys
GROQ_API_KEY=

# Gemini fallback key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Legacy Dev.to publisher only: Settings > Extensions > DEV Community API Keys
DEVTO_API_KEY=

# Set to true to stop the agent before any action
KILL_SWITCH=false
